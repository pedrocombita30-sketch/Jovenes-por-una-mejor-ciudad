# Base de datos
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="cambia-esta-frase-secreta-en-produccion"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3001
NODE_ENV=development
# Si el servidor está detrás de un proxy (Render, Heroku, etc.), pon 1 para que el límite de
# intentos use la IP real del usuario y no la del proxy.
# TRUST_PROXY=1

# CORS
FRONTEND_URL="http://localhost:5173"

# IA (opcional - sin clave usa modo mock)
OPENAI_API_KEY=""
AI_MODEL="gpt-3.5-turbo"